#version 460
#define MB_INT8
#include "mb_common.glsl"
layout(local_size_x = 256) in;
// split-K epilogue of skinny_s8.comp: acc = sum of the int32 partials (exact), then linear_dq_s8's
// dequantization: (float)((double)acc * ((double)row_scale[m] * (double)w_scale[n])) + bias[n]
layout(push_constant, scalar) uniform PC { I32 part; F32 rs; F32 bias; F32 ws; F32 y; int M; int N; int nsplit; } pc;
void main() {
    int64_t gi = MB_GID;
    int MN = pc.M * pc.N;
    if (gi >= MN) return;
    int i = int(gi), m = i / pc.N, n = i % pc.N;
    int acc = 0;
    for (int s = 0; s < pc.nsplit; s++) acc += pc.part.v[s * MN + i];
    precise double sc = double(pc.rs.v[m]) * double(pc.ws.v[n]);
    precise double d = double(acc) * sc;
    precise float yv = float(d);
    if (uint64_t(pc.bias) != 0ul) yv = yv + pc.bias.v[n];
    pc.y.v[i] = yv;
}
