#version 460
#include "mb_common.glsl"
layout(local_size_x = 256) in;
// x / d along the middle axis of [outer, R, inner], one workgroup per line:
// kind 0 rms (sqrt(mean(x^2) + eps)), 1 mean|x|, 2 l2
layout(push_constant, scalar) uniform PC { F32 x; F32 y; int outer; int R; int inner; int kind; float eps; } pc;
shared float sv[256];
void main() {
    int line = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x);
    if (line >= pc.outer * pc.inner) return;
    int o = line / pc.inner, j = line % pc.inner;
    int base = o * pc.R * pc.inner + j, t = int(gl_LocalInvocationID.x);
    float a = 0.0;
    for (int r = t; r < pc.R; r += 256) { float v = pc.x.v[base + r * pc.inner]; a += pc.kind == 1 ? abs(v) : v * v; }
    sv[t] = a;
    barrier();
    for (int s = 128; s > 0; s >>= 1) { if (t < s) sv[t] += sv[t + s]; barrier(); }
    a = sv[0];
    float d = pc.kind == 0 ? sqrt(a / float(pc.R) + pc.eps) : pc.kind == 1 ? a / float(pc.R) : sqrt(a);
    float inv = 1.0 / d;
    for (int r = t; r < pc.R; r += 256) { int k = base + r * pc.inner; pc.y.v[k] = pc.x.v[k] * inv; }
}
