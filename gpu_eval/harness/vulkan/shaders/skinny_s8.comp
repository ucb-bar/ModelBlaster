#version 460
#define MB_INT8
#include "mb_common.glsl"
// kernel_linear_dq_s8 for M <= 64 rows on a PRE-PACKED int8 weight (walk_vulkan.pack_weight_s8):
// for each block of 64 columns nb and each 16-k chunk kq, the 64 columns' 16 bytes are contiguous,
//     P[((nb * K/16 + kq) * 64 + c) * 16 + i] = W[nb*64 + c, 16*kq + i]   (N zero-padded to 64),
// so one wave's uvec4 load is one contiguous 1 KiB: int8 weights stream at the DRAM rate.
// One invocation per output column (NC columns 64 apart, specialization constant 1), all M rows
// in registers (MT, specialization constant 0);
// the activation's 16 bytes per row are the same for the whole wave (uniform address: scalar
// loads) and enter packed 4 x int8 dot products. K is split over gl_WorkGroupID.y: with split != 0
// each split writes raw int32 partial sums to part + s*M*N and linear_dq_s8_epi.comp adds them
// (exact) and dequantizes; with split == 0 the dequantizing epilogue runs here. Bit-exact either way:
// the int32 sum is the reference's (two's-complement addition is associative).
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require
layout(constant_id = 0) const int MT = 32;
layout(constant_id = 1) const int NC = 1;   // 64-column blocks per workgroup (each lane: NC columns, 64 apart)
layout(local_size_x = 64) in;
layout(buffer_reference, std430, buffer_reference_align = 16) restrict readonly buffer U4 { uvec4 v[]; };
layout(push_constant, scalar) uniform PC {
    I8 x; F32 rs; I8 w; F32 bias; F32 ws; F32 y; F32 y1; F32 y2; F32 add; I32 part; int M; int K; int N; int kchunk; int split;
    int N0; int N1;
} pc;
void main() {
    const int K = pc.K, N = pc.N;
    int c = int(gl_LocalInvocationID.x);
    int s = int(gl_WorkGroupID.y);
    int kbeg = s * pc.kchunk, kend = min(K, kbeg + pc.kchunk);
    int acc[NC][MT];
    [[unroll]] for (int b = 0; b < NC; b++) [[unroll]] for (int m = 0; m < MT; m++) acc[b][m] = 0;
    const uint64_t bstride = uint64_t(K >> 4) * 1024ul;               // one 64-column block's bytes
    int nb0 = int(gl_WorkGroupID.x) * NC;
    int nblk = (N + 63) >> 6;
    uint64_t wp = uint64_t(pc.w) + ((uint64_t(nb0) * uint64_t(K >> 4) + uint64_t(kbeg >> 4)) * 64ul + uint64_t(c)) * 16ul;
    uint64_t xp = uint64_t(pc.x) + uint64_t(kbeg);
    int steps = (kend - kbeg) >> 4;
    uvec4 wv[NC];
    [[unroll]] for (int b = 0; b < NC; b++) wv[b] = (steps > 0 && nb0 + b < nblk) ? U4(wp + uint64_t(b) * bstride).v[0] : uvec4(0);
    for (int it = 0; it < steps; it++) {
        uvec4 wn[NC];                                                    // next chunk in flight
        [[unroll]] for (int b = 0; b < NC; b++)
            wn[b] = (it + 1 < steps && nb0 + b < nblk) ? U4(wp + uint64_t(b) * bstride + 1024ul).v[0] : wv[b];
        uint64_t xr = xp;
        [[unroll]] for (int m = 0; m < MT; m++) {
            uvec4 a = U4(xr).v[0];
            [[unroll]] for (int b = 0; b < NC; b++) {
                int t = acc[b][m];
                t += dotPacked4x8EXT(int(a.x), int(wv[b].x));
                t += dotPacked4x8EXT(int(a.y), int(wv[b].y));
                t += dotPacked4x8EXT(int(a.z), int(wv[b].z));
                t += dotPacked4x8EXT(int(a.w), int(wv[b].w));
                acc[b][m] = t;
            }
            xr += uint64_t(K);
        }
        [[unroll]] for (int b = 0; b < NC; b++) wv[b] = wn[b];
        wp += 1024ul;
        xp += 16ul;
    }
    bool hb = uint64_t(pc.bias) != 0ul, ha = uint64_t(pc.add) != 0ul;
    [[unroll]] for (int b = 0; b < NC; b++) {
        int n = (nb0 + b) * 64 + c;
        if (n >= N) break;
        if (pc.split != 0) {
            int cb = s * MT * N + n;
            [[unroll]] for (int m = 0; m < MT; m++) pc.part.v[cb + m * N] = acc[b][m];
            continue;
        }
        double wsn = double(pc.ws.v[n]);
        float bv = hb ? pc.bias.v[n] : 0.0;
        [[unroll]] for (int m = 0; m < MT; m++) {
            precise double sc = double(pc.rs.v[m]) * wsn;
            precise double d = double(acc[b][m]) * sc;
            precise float yv = float(d);
            if (hb) yv = yv + bv;
            if (ha) yv = pc.add.v[m * N + n] + yv;
            MB_DQ_STORE(pc.y, pc.y1, pc.y2, N, pc.N0, pc.N1, m, n, yv);
        }
    }
}
