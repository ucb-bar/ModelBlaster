#version 460
#include "mb_common.glsl"
layout(local_size_x = 256) in;
// softmax / log-softmax over the middle axis of [outer, R, inner]: one
// workgroup per (o, j) line; inner == 1 is the row softmax (kernel_softmax)
layout(push_constant, scalar) uniform PC { F32 x; F32 y; int outer; int R; int inner; int log_out; float in_scale; } pc;
#extension GL_KHR_shader_subgroup_arithmetic : require
shared float sv[256];
// workgroup max / sum: within each subgroup, then across the (<= 256 / subgroup size) partials
float tree(float v, bool is_max) {
    v = is_max ? subgroupMax(v) : subgroupAdd(v);
    if (gl_NumSubgroups == 1) return v;
    if (subgroupElect()) sv[gl_SubgroupID] = v;
    barrier();
    float r = sv[0];
    for (uint i = 1; i < gl_NumSubgroups; i++) r = is_max ? max(r, sv[i]) : r + sv[i];
    barrier();
    return r;
}
void main() {
    int line = int(gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x);
    if (line >= pc.outer * pc.inner) return;
    int o = line / pc.inner, j = line % pc.inner;
    int base = o * pc.R * pc.inner + j;
    int t = int(gl_LocalInvocationID.x);
    float sc = pc.in_scale;
    float m = -1.0 / 0.0;
    for (int r = t; r < pc.R; r += 256) m = max(m, pc.x.v[base + r * pc.inner] * sc);
    m = tree(m, true);
    float s = 0.0;
    for (int r = t; r < pc.R; r += 256) s += exp(pc.x.v[base + r * pc.inner] * sc - m);
    s = tree(s, false);
    if (pc.log_out != 0) {
        float ls = log(s);
        for (int r = t; r < pc.R; r += 256) { int k = base + r * pc.inner; pc.y.v[k] = (pc.x.v[k] * sc - m) - ls; }
    } else {
        float inv = 1.0 / s;
        for (int r = t; r < pc.R; r += 256) { int k = base + r * pc.inner; pc.y.v[k] = exp(pc.x.v[k] * sc - m) * inv; }
    }
}
